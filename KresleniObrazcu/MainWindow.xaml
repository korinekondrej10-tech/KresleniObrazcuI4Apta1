<Window x:Class="KresleniObrazcu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KresleniObrazcu"
        mc:Ignorable="d"
        Title="Kreslení obrazců"
        Height="600"
        Width="1000">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Ovládací prvky -->

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <TextBlock Text="Obrazec:"
                       VerticalAlignment="Center"
                       Margin="5"/>

            <ComboBox x:Name="cmbObrazec"
                      Width="130"
                      SelectedIndex="0">

                <ComboBoxItem Content="Obdélník"/>
                <ComboBoxItem Content="Elipsa"/>
                <ComboBoxItem Content="Trojúhelník"/>

            </ComboBox>

            <TextBlock Text="Tloušťka:"
                       VerticalAlignment="Center"
                       Margin="10,0,5,0"/>

            <ComboBox x:Name="cmbTloustka"
                      Width="70"
                      SelectedIndex="1">

                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="6"/>

            </ComboBox>

            <TextBlock Text="Výplň:"
                       VerticalAlignment="Center"
                       Margin="10,0,5,0"/>

            <ComboBox x:Name="cmbVypln"
                      Width="130"
                      SelectedIndex="0">

                <ComboBoxItem Content="Modrá"/>
                <ComboBoxItem Content="Zelená"/>
                <ComboBoxItem Content="Žlutá"/>
                <ComboBoxItem Content="Červená"/>
                <ComboBoxItem Content="Bez výplně"/>

            </ComboBox>

            <Button Content="Smazat vše"
                    Width="100"
                    Margin="20,0,0,0"
                    Click="BtnSmazat_Click"/>

        </StackPanel>

        <!-- Kreslicí plocha -->

        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="1"
                Margin="0,0,10,0">

            <Canvas x:Name="platno"
                    Background="White"
                    MouseLeftButtonDown="Platno_MouseLeftButtonDown"/>

        </Border>

        <!-- Seznam obrazců -->

        <StackPanel Grid.Row="1"
                    Grid.Column="1">

            <TextBlock Text="Vykreslené obrazce"
                       FontWeight="Bold"
                       FontSize="15"
                       Margin="0,0,0,10"/>

            <ListBox x:Name="lstObrazce"/>

        </StackPanel>

    </Grid>
</Window>
